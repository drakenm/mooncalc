{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoonCalc",
  "mainBinaryName": "mooncalc-tauri",
  "identifier": "org.mooncalc.app",
  "build": {
    "frontendDist": "../../frontend/tauri/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../frontend/tauri"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../frontend/tauri"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MoonCalc",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Crescent Moon visibility maps and ephemerides",
    "copyright": "MIT licence",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
