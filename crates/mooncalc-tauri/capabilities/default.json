{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least privilege for the main window: only MoonCalc's own commands. No core plugins (filesystem, shell, events, window control) are granted.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-criteria-list",
    "allow-compute-visibility-map",
    "allow-export-map-png",
    "allow-save-map-png",
    "allow-location-report",
    "allow-sky-scene",
    "allow-sky-stars",
    "allow-trajectory-day",
    "allow-moon-view",
    "allow-moon-features",
    "allow-search-cities",
    "allow-nearest-city",
    "allow-earliest-sighting",
    "allow-basemap",
    "allow-load-de440"
  ]
}
